<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TimetableWidgetHeaderTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/widget_primary_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TimetableWidgetHeaderSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_secondary_text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TimetableWidgetWeekControl">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/widget_primary_text</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TimetableWidgetColumnTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/widget_secondary_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TimetableWidgetCourseTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_primary_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TimetableWidgetCourseDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_secondary_text</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TimetableWidgetGridPeriodHeader">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/widget_muted_text</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="TimetableWidgetGridHeader">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/widget_secondary_text</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TimetableWidgetGridPeriod">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/widget_muted_text</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="TimetableWidgetGridCell">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:background">@drawable/timetable_widget_course_background</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingLeft">3dp</item>
        <item name="android:paddingRight">3dp</item>
        <item name="android:textColor">@color/widget_primary_text</item>
        <item name="android:textSize">8sp</item>
    </style>
</resources>
